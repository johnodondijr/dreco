# Dreco environment variables (set these in Vercel → Project → Environment Variables).
# Values are examples/placeholders — never commit real secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# Server-side (serverless functions). SUPABASE_URL is also used as a fallback
# for the public URL below.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never exposed to the client
SUPABASE_ANON_KEY=your-anon-key

# Public Supabase config returned by /api/dreco-config to the browser. If unset,
# the config endpoint falls back to SUPABASE_URL / SUPABASE_ANON_KEY above.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Auth / workspace signup ─────────────────────────────────────────────────
# REQUIRED for workspace self-signup. If unset, create_workspace is disabled
# (fail-closed). Use a long random string; share only with people allowed to
# create workspaces.
DRECO_SIGNUP_SECRET=change-me-to-a-long-random-string

# Recommended: lock CORS to your exact origin instead of the *.vercel.app fallback.
# DRECO_ALLOWED_ORIGIN=https://dreco-app.vercel.app

# ── Optional defaults / config ──────────────────────────────────────────────
# DRECO_DEFAULT_COMPANY_ID=dreco-workspace
# DRECO_DEFAULT_COMPANY_NAME=Dreco Workspace
# DRECO_GENERAL_JOBS_COUNTRIES=General
# DRECO_DEFAULT_ADMIN_USERNAME=admin
# DRECO_RETIRED_USERNAMES=
# DRECO_BLOCKED_ADMIN_ALIASES=
# DRECO_RECOVERY_CODE=

# Email delivery for verification and password recovery codes.
# Recommended: install Resend from Vercel Marketplace, then set a verified sender.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# DRECO_EMAIL_FROM=Dreco <hello@yourdomain.com>

# ── CI secrets (GitHub Actions, not app runtime) ────────────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
